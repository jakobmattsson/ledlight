{
  "git": {
    "remote": "origin",
    "defaultBranch": "main",
    "branchPrefix": "codex/"
  },
  "tests": {
    "commands": [
      "npm run lint",
      "node --test 'tests/unit/**/*.test.js' 'tests/integration/**/*.test.js' 'tests/conventions/*.test.js'"
    ],
    "receiptMaxAgeMinutes": 60,
    "npmTestUsesRunner": true
  },
  "loggingDirectory": "tmp/logs"
}
