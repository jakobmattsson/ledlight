{
  "git": {
    "remote": "origin",
    "defaultBranch": "main",
    "branchPrefix": "codex/",
    "releaseTestWorkflow": "package.yml",
    "releaseRequiredChecks": [
      "Full test suite",
      "Package on macOS",
      "Package on Linux",
      "Package on Windows"
    ]
  },
  "tests": {
    "commands": [
      "npm run lint",
      "node dist/scripts/ci/test-suite.js"
    ],
    "receiptMaxAgeMinutes": 60,
    "npmTestUsesRunner": true
  },
  "loggingDirectory": "tmp/logs"
}
