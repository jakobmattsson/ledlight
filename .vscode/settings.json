    "rules": {
      "type:typescript": "#4EC9B0",
      "class:typescript": "#4EC9B0",
      "interface:typescript": "#4EC9B0",
      "typeParameter:typescript": "#4EC9B0",
      "variable:typescript": "#9CDCFE",
      "parameter:typescript": "#E5C07B",
      "property:typescript": "#9CDCFE",
      "function:typescript": "#DCDCAA",
      "method:typescript": "#DCDCAA"
    }
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "support.type.primitive.ts",
        "settings": {
          "foreground": "#4EC9B0"
        }
      }
    ]
  }
}
