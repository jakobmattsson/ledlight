{
  "name": "@jakobm/ledlight",
  "version": "0.4.3",
  "description": "A small, fast Ledger-compatible parser, SQLite store, and reporting library.",
  "license": "MIT",
  "author": "Jakob Mattsson",
  "homepage": "https://github.com/jakobmattsson/ledlight#readme",
  "bugs": {
    "url": "https://github.com/jakobmattsson/ledlight/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakobmattsson/ledlight.git"
  },
  "keywords": [
    "accounting",
    "cli",
    "ledger",
    "sqlite"
  ],
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "docs/api.md",
    "docs/ledger-cli-equivalence.md",
    "docs/ledlight.md",
    "docs/package.md",
    "docs/why-ledlight.md",
    "dist/scripts/ledger-compatibility/**/*.js",
    "dist/scripts/ledger-compatibility/**/*.d.ts",
    "dist/scripts/ledger-compatibility/**/*.yaml",
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "dist/src/**/*.yaml",
    "dist/src/**/*.sql",
    "dist/src/**/*.ohm"
  ],
  "bin": {
    "ledlight": "dist/src/run.js",
    "ledlight-cmp": "dist/scripts/ledger-compatibility/compare-ledger.js"
  },
  "engines": {
    "node": "^22.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node dist/scripts/build/copy-assets.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "pretest": "npm run build",
    "prelint": "npm run build",
    "prelint:fix": "npm run build",
    "prepack": "npm run build",
    "prebenchmark": "npm run build",
    "prearchitecture:generate": "npm run build",
    "pretest:package": "npm run build",
    "pretest:conventions": "npm run build",
    "pretest:unit": "npm run build",
    "pretest:integration": "npm run build",
    "pretest:ledger": "npm run build",
    "architecture:generate": "portico-architecture --modules dist/src/modules --output architecture",
    "benchmark": "node dist/scripts/benchmarks/run.js",
    "cleanup:branches": "worktree-keeper cleanup-merged-branches",
    "cleanup:empty-directories": "worktree-keeper remove-empty-directories",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "worktree-keeper release",
    "report:allure": "allure awesome allure-results --output allure-report --report-name 'Ledlight tests'",
    "test": "worktree-keeper run-tests",
    "test:coverage": "c8 --all --src=dist/src --include='dist/src/**/*.js' --reporter=text-summary --reporter=lcov --reporter=json-summary --reporter=html npm test -- rerun",
    "test:ledger": "node --test dist/tests/integration/src/cases.test.js dist/tests/integration/src/cli/compare-ledger-script.test.js",
    "test:package": "node --test dist/tests/package/package.test.js",
    "test:conventions": "node --test 'dist/tests/conventions/*.test.js'",
    "test:unit": "node --test 'dist/tests/unit/**/*.test.js'",
    "test:integration": "node --test 'dist/tests/integration/**/*.test.js'"
  },
  "dependencies": {
    "@jakobm/portico": "0.2.0",
    "better-sqlite3": "13.0.3",
    "commander": "^13.1.0",
    "diff": "^9.0.0",
    "env-paths": "2.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "allure": "3.20.1",
    "allure-js-commons": "3.13.0",
    "allure-node-test": "3.13.0",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "espree": "^10.4.0",
    "globals": "^17.12.0",
    "ohm-js": "17.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "worktree-keeper": "0.8.0"
  }
}
