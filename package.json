{
  "name": "@jakobm/ledlight",
  "version": "0.3.0",
  "description": "A small, fast Ledger-compatible parser, SQLite store, and reporting library.",
  "license": "MIT",
  "author": "Jakob Mattsson",
  "homepage": "https://github.com/jakobmattsson/ledlight#readme",
  "bugs": {
    "url": "https://github.com/jakobmattsson/ledlight/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakobmattsson/ledlight.git"
  },
  "keywords": [
    "accounting",
    "cli",
    "ledger",
    "sqlite"
  ],
  "type": "commonjs",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "docs/api.md",
    "docs/ledger-cli-equivalence.md",
    "docs/ledlight.md",
    "docs/package.md",
    "docs/why-ledlight.md",
    "scripts",
    "src"
  ],
  "bin": {
    "ledlight": "src/run.js",
    "ledlight-cmp": "scripts/ledger-compatibility/compare-ledger.js"
  },
  "engines": {
    "node": "^22.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "benchmark": "node scripts/benchmarks/run.js",
    "cleanup:branches": "worktree-keeper cleanup-merged-branches",
    "cleanup:empty-directories": "worktree-keeper remove-empty-directories",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "report:allure": "allure awesome allure-results --output allure-report --report-name 'Ledlight tests'",
    "test": "worktree-keeper run-tests",
    "test:coverage": "c8 --all --src=src --include='src/**/*.js' --reporter=text-summary --reporter=lcov --reporter=json-summary --reporter=html npm test -- rerun",
    "test:ledger": "node --test tests/integration/src/cases.test.js tests/integration/src/cli/compare-ledger-script.test.js",
    "test:package": "node --test tests/package/package.test.js",
    "test:conventions": "node --test 'tests/conventions/*.test.js'",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:integration": "node --test 'tests/integration/**/*.test.js'"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "commander": "^13.1.0",
    "diff": "^9.0.0",
    "env-paths": "2.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "allure": "3.20.1",
    "allure-js-commons": "3.13.0",
    "allure-node-test": "3.13.0",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "espree": "^10.4.0",
    "globals": "^17.12.0",
    "ohm-js": "17.5.0",
    "worktree-keeper": "0.7.2"
  }
}
