Keeps a slash-separated date in a posting comment as plain text.

========== TEXT ==========

2024-01-01 Trade
  Assets:Cash  1 SEK ; [2024/01/02] imported
  Equity:Opening

========== JSON ==========

{
  "source": "fixture.ledger",
  "entries": [
    {
      "type": "transaction",
      "date": "2024-01-01",
      "description": "Trade",
      "comment": null,
      "postings": [
        {
          "type": "posting",
          "account": "Assets:Cash",
          "amount": {
            "quantity": "1",
            "commodity": "SEK"
          },
          "lotCost": null,
          "cost": null,
          "balanceAssignment": null,
          "balanceAssertion": null,
          "postingDate": null,
          "comment": "[2024/01/02] imported",
          "location": {
            "source": "fixture.ledger",
            "line": 2,
            "column": 3
          }
        },
        {
          "type": "posting",
          "account": "Equity:Opening",
          "amount": null,
          "lotCost": null,
          "cost": null,
          "balanceAssignment": null,
          "balanceAssertion": null,
          "postingDate": null,
          "comment": null,
