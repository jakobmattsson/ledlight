The investment-performance command reads automatic standard input.

========== CLI ==========

ledlight investment-performance --format json <<'LEDGER'
commodity SEK
  default
  format 1,000.00 SEK
commodity STOCK
  format 1,000 STOCK
account Assets:Stock
account Assets:Cash
P 2024-01-01 STOCK 12 SEK

2024-01-01 Purchase
  Assets:Stock  10 STOCK {10 SEK}
  Assets:Cash  -100 SEK
LEDGER

========== OUTPUT ==========

{
  "from": "2024-01-01",
  "to": "2024-01-01",
  "commodities": [
    "SEK",
    "STOCK"
  ],
  "valuationCommodity": "SEK",
  "openingValue": 0,
  "endingValue": 20,
  "netContributions": 0,
  "profitLoss": 20,
  "timeWeightedReturn": null,
  "moneyWeightedReturn": null,
  "moneyWeightedReturnTotal": null,
  "points": []
}
