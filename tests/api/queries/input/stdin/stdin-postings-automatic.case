    "postingDate": "2024-01-01",
    "account": "Assets:Cash",
    "postingComments": [],
    "amount": {
      "quantity": "-100",
      "commodity": "SEK"
    },
    "lotCost": null,
    "cost": null,
    "balanceAssignment": null,
    "balanceAssertion": null,
    "amounts": [
      {
        "quantity": "-100",
        "commodity": "SEK",
        "balance": "-100"
      }
    ]
  }
]
