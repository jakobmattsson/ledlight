A sale-day interval uses the opening position and net sale proceeds.

========== API ==========

investmentPerformance({ accounts: ['^Assets:'], includeCommodities: ['FUND'], from: '2024-01-02', to: '2024-01-02' })

========== FILE ==========

commodity USD
  format 1,000.00 USD
  default
commodity FUND
  format 1,000.00 FUND
account Assets:Broker
account Assets:Other
account Assets:Cash
account Assets:Unrelated
account Equity:Opening
account Income:Gains
account Expenses:Fees
2024-01-01 Purchase
  Assets:Broker  1 FUND {100 USD}
  Assets:Cash  -100 USD

P 2024-01-01 FUND 120 USD
2024-01-02 Sale
  Assets:Broker  -0.5 FUND {100 USD} @ 130 USD
  Assets:Cash  65 USD
  Income:Gains  -15 USD
P 2024-01-02 FUND 140 USD

========== OUTPUT ==========

{
  "from": "2024-01-02",
  "to": "2024-01-02",
  "commodities": [
    "FUND"
  ],
  "valuationCommodity": "USD",
  "openingValue": 120,
  "endingValue": 70,
  "netContributions": -65,
  "profitLoss": 15,
  "timeWeightedReturn": 0.125,
  "timeWeightedReturnAnnualized": null,
  "moneyWeightedReturn": null,
  "moneyWeightedReturnTotal": null,
  "points": [
    {
      "date": "2024-01-02",
      "value": 70,
      "netContributions": -65,
      "profitLoss": 15,
      "timeWeightedReturn": 0.125,
      "timeWeightedReturnAnnualized": null,
      "moneyWeightedReturn": null,
      "moneyWeightedReturnTotal": null
    }
  ]
}
