A destination-only selection values an incoming transfer at market.

========== API ==========

investmentPerformance({ accounts: ['^Assets:Other$'], commodities: ['FUND'] })

========== FILE ==========

commodity USD
  format 1,000.00 USD
  default
commodity FUND
  format 1,000.00 FUND
account Assets:Broker
account Assets:Other
account Assets:Cash
account Assets:Unrelated
account Equity:Opening
account Income:Gains
account Expenses:Fees
2024-01-01 Purchase
  Assets:Broker  1 FUND {100 USD}
  Assets:Cash  -100 USD
P 2024-01-01 FUND 100 USD
2024-01-02 Transfer
  Assets:Broker  -1 FUND {100 USD}
  Assets:Other  1 FUND {100 USD}
P 2024-01-02 FUND 120 USD

========== OUTPUT ==========

{
  "from": "2024-01-02",
  "to": "2024-01-02",
  "commodities": [
    "FUND"
  ],
  "valuationCommodity": "USD",
  "openingValue": 0,
  "endingValue": 120,
  "netContributions": 120,
  "profitLoss": 0,
  "timeWeightedReturn": 0,
  "moneyWeightedReturn": null,
  "moneyWeightedReturnTotal": null,
  "points": [
    {
      "date": "2024-01-02",
      "value": 120,
      "netContributions": 120,
      "profitLoss": 0,
      "timeWeightedReturn": 0,
      "moneyWeightedReturn": null,
      "moneyWeightedReturnTotal": null
    }
  ]
}
