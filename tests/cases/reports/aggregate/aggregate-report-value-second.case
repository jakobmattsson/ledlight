Indirect market prices are resolved at the upper date.

========== API ==========

aggregate({ to: '2024-01-02', inValuationCommodity: true })

========== FILE ==========

commodity SEK
  default
  format 1,000.00 SEK
commodity FUND
commodity NOK
P 2024-01-01 FUND 10 SEK
P 2024-01-02 FUND 12 NOK
P 2024-01-02 NOK 1.1 SEK

2024-01-01 Opening
  Assets:Cash  100.000000000000000001 SEK
  Assets:Fund  2 FUND {10 SEK}
  Equity:Opening

2024-01-02 Adjust cash
  Assets:Cash  = 150 SEK
  Equity:Opening

2024-01-03 Future
  Assets:Cash  1000 SEK
  Equity:Opening

========== OUTPUT ==========

[
  {
    "account": "Assets:Cash",
    "commodity": "SEK",
    "quantity": "150"
  },
  {
    "account": "Assets:Fund",
    "commodity": "SEK",
    "quantity": "20"
  },
  {
    "account": "Equity:Opening",
    "commodity": "SEK",
    "quantity": "-170"
  }
]
