Ledlight {
  document = topLevel* end

  topLevel
    = transaction
    | commodityDirective
    | accountDirective
    | tagDirective
    | includeDirective
    | priceDirective
    | topLevelComment
    | blankLine

  transaction = transactionHeader transactionBody+
  transactionBody = blankLine | indentedComment | posting

  transactionHeader = date horizontal+ description comment lineEnd
  description = ~horizontal ~";" ~newline any (~";" ~newline any)*
  comment = inlineComment?

  posting = indent account amountPart? horizontal* postingComment? lineEnd
  account = accountCharacter+
  accountCharacter = ~fieldSeparator ~";" ~newline any
  amountPart = fieldSeparator amountExpression?

  amountExpression = balanceAssignment | explicitAmount
  balanceAssignment = "=" horizontal* amount
  explicitAmount = amount cost? balanceAssertion?
  cost = horizontal* ("@@" | "@") horizontal* amount
  balanceAssertion = horizontal* "=" horizontal* amount
  amount = number (horizontal+ commoditySymbol)?

  number = sign? decimal numberBoundary
  sign = "+" | "-"
  decimal = digit+ ("." digit*)?  -- leadingDigits
          | "." digit+           -- leadingPoint
  numberBoundary = &(horizontal | "@" | "=" | ";" | newline) | end

  commoditySymbol = quotedSymbol | bareCommoditySymbol
  quotedSymbol = "\"" (~"\"" ~newline any)* "\""  -- double
               | "'" (~"'" ~newline any)* "'"       -- single
  bareCommoditySymbol = (~horizontal ~"@" ~"=" ~";" ~newline any)+

  includeDirective = "include" horizontal+ directiveValue inlineComment? lineEnd
  accountDirective = "account" horizontal+ directiveValue inlineComment? lineEnd
  tagDirective = "tag" horizontal+ directiveValue inlineComment? lineEnd

  commodityDirective = "commodity" horizontal+ directiveValue inlineComment? lineEnd commodityBody*
  commodityBody = blankLine | commodityProperty
  commodityProperty = indent commodityPropertyName commodityPropertyValue? inlineComment? lineEnd
  commodityPropertyName = "format" | "default" | "nomarket"
  commodityPropertyValue = horizontal+ directiveValue

  priceDirective = "P" horizontal+ date horizontal+ commoditySymbol horizontal+ amount horizontal* inlineComment? lineEnd

  indentedComment = indent commentMarker horizontal* commentText lineEnd
  topLevelComment = topLevelCommentMarker commentText lineEnd
  postingComment = horizontal* ";" horizontal* postingDate? commentText
  postingDate = "[" date "]" horizontal*
  inlineComment = horizontal* ";" horizontal* commentText
  commentMarker = ";" | "#" | "%"
  topLevelCommentMarker = commentMarker | ":"
  commentText = (~newline any)*
  directiveValue = (~";" ~newline any)+

  date = year dateSeparator twoDigits dateSeparator twoDigits
  year = digit digit digit digit
  twoDigits = digit digit
  dateSeparator = "-" | "/"

  fieldSeparator = "\t"                -- tab
                 | "  " horizontal*    -- spaces
  indent = horizontal+
  horizontal = " " | "\t"
  blankLine = horizontal* newline
  lineEnd = newline  -- newline
          | end      -- end
  newline = "\r\n" | "\n"
}
