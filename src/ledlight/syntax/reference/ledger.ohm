Ledlight {
  document = topLevel* end

  topLevel
    = transaction
    | commodityDirective
    | accountDirective
    | tagDirective
    | includeDirective
    | priceDirective
    | topLevelComment
    | blankLine

  transaction = transactionHeader transactionBody+
  transactionBody = indentedComment | posting

  transactionHeader = date horizontal+ description inlineComment? lineEnd
  description = (~forbiddenDescriptionSymbolCharacter any)+

  posting = indent account amountPart? horizontal* postingComment? lineEnd
  account = (~forbiddenAccountSymbolCharacter any)+
  amountPart = fieldSeparator amountExpression?

  amountExpression = balanceAssignment | explicitAmount
  balanceAssignment = "=" horizontal* amount
  explicitAmount = amount cost? balanceAssertion?
  cost = horizontal* ("@@" | "@") horizontal* amount
  balanceAssertion = horizontal* "=" horizontal* amount
  amount = number horizontal+ commoditySymbol

  number = sign? digit+ ("." digit+)?
  sign = "+" | "-"

  commoditySymbol = quotedCommoditySymbol | bareCommoditySymbol
  quotedCommoditySymbol = "\"" (~"\"" ~newline any)+ "\""
  bareCommoditySymbol = (~forbiddenCommoditySymbolCharacter any)+

  includeDirective = "include" horizontal+ directiveValue inlineComment? lineEnd
  accountDirective = "account" horizontal+ directiveValue inlineComment? lineEnd
  tagDirective = "tag" horizontal+ directiveValue inlineComment? lineEnd

  commodityDirective = "commodity" horizontal+ commoditySymbol inlineComment? horizontal* lineEnd commodityBody*
  commodityBody = indent "format" horizontal+ commodityFormat inlineComment? horizontal* lineEnd  -- format
                | indent "default" (horizontal+ directiveValue)? inlineComment? lineEnd            -- default
  commodityFormat = formatQuantity horizontal+ commoditySymbol
  formatQuantity = groupedFormatInteger ("." digit+)?  -- grouped
                 | digit+ ("." digit+)?                -- ungrouped
  groupedFormatInteger = digit digit? digit? ("," digit digit digit)+

  priceDirective = "P" horizontal+ date horizontal+ commoditySymbol horizontal+ amount horizontal* inlineComment? lineEnd

  indentedComment = indent ";" horizontal* commentText lineEnd
  topLevelComment = ";" horizontal* commentText lineEnd
  postingComment = ";" horizontal* ("[" date "]" horizontal*)? commentText
  inlineComment = horizontal* ";" horizontal* commentText
  commentText = (~newline any)*
  directiveValue = (~forbiddenDirectiveValueCharacter any)+

  date = digit digit digit digit "-" digit digit "-" digit digit

  fieldSeparator = "\t"                -- tab
                 | "  " horizontal*    -- spaces
  indent = horizontal+
  horizontal = " " | "\t"
  blankLine = horizontal* newline
  lineEnd = newline  -- newline
          | end      -- end
  newline = "\r\n" | "\n"

  forbiddenDescriptionSymbolCharacter = ";" | newline
  forbiddenAccountSymbolCharacter = fieldSeparator | ";" | newline
  forbiddenCommoditySymbolCharacter = horizontal | "@" | "=" | ";" | "\"" | "'" | newline
  forbiddenDirectiveValueCharacter = ";" | newline
}
