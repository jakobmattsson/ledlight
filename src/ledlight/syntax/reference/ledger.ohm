Ledlight {
  document = topLevel* end

  topLevel
    = date spacing+ description transactionComment? lineEnd (indentedComment | posting)+                  -- transaction
    | "commodity" spacing+ commoditySymbol inlineComment? spacing* lineEnd commodityBody*                 -- commodity
    | "account" spacing+ directiveValue inlineComment? lineEnd                                            -- account
    | "tag" spacing+ directiveValue inlineComment? lineEnd                                                -- tag
    | "include" spacing+ directiveValue inlineComment? lineEnd                                            -- include
    | "P" spacing+ date spacing+ commoditySymbol spacing+ amount spacing* inlineComment? lineEnd          -- price
    | ";" spacing* commentText lineEnd                                                                    -- comment
    | spacing* newline                                                                                    -- blank

  description = (~forbiddenDescriptionSymbolCharacter any)+
  indentedComment = spacing+ ";" spacing* metadataComment lineEnd

  posting = spacing+ account amountPart? spacing* postingComment? lineEnd
  account = (~forbiddenAccountSymbolCharacter any)+
  amountPart = fieldSeparator amountExpression?

  amountExpression = balanceAssignment | explicitAmount
  balanceAssignment = "=" spacing* amount
  explicitAmount = amount cost? balanceAssertion?
  cost = spacing* ("@@" | "@") spacing* amount
  balanceAssertion = spacing* "=" spacing* amount
  amount = number spacing+ commoditySymbol

  number = sign? digit+ ("." digit+)?
  sign = "+" | "-"

  commodityBody = spacing+ "format" spacing+ formatQuantity spacing+ commoditySymbol inlineComment? spacing* lineEnd      -- format
                | spacing+ "default" inlineComment? lineEnd                                                               -- default
  formatQuantity = digit "," digit digit digit ("." digit+)?    -- grouped
                 | digit digit digit digit ("." digit+)?        -- ungrouped

  commoditySymbol = (~forbiddenCommoditySymbolCharacter any)+

  postingComment = ";" spacing* ("[" date "]" spacing*)? metadataComment
  transactionComment = spacing* ";" spacing* metadataComment
  inlineComment = spacing* ";" spacing* commentText
  metadataComment = binaryTags (spacing+ commentText)?     -- tags
                  | tagName ":" spacing+ commentText       -- value
                  | commentText                            -- text
  binaryTags = ":" tagName (":" tagName)* ":"
  tagName = (~forbiddenTagNameCharacter any)+
  commentText = (~newline any)*
  directiveValue = (~forbiddenDirectiveValueCharacter any)+

  date = digit digit digit digit "-" digit digit "-" digit digit

  forbiddenDirectiveValueCharacter = ";" | newline
  forbiddenDescriptionSymbolCharacter = ";" | newline
  forbiddenAccountSymbolCharacter = fieldSeparator | ";" | newline
  forbiddenCommoditySymbolCharacter = spacing | "@" | "=" | ";" | "\"" | "'" | newline
  forbiddenTagNameCharacter = spacing | ":" | ";" | newline

  fieldSeparator = "\t"                -- tab
                 | "  " spacing*       -- spaces

  lineEnd = newline | end
  spacing = " " | "\t"
  newline = "\r\n" | "\n"
}
