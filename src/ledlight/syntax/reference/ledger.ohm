Ledlight {
  document = topLevel* end

  topLevel
    = date horizontal+ description transactionComment? lineEnd (indentedComment | posting)+                  -- transaction
    | "commodity" horizontal+ commoditySymbol inlineComment? horizontal* lineEnd commodityBody*              -- commodity
    | "account" horizontal+ directiveValue inlineComment? lineEnd                                            -- account
    | "tag" horizontal+ directiveValue inlineComment? lineEnd                                                -- tag
    | "include" horizontal+ directiveValue inlineComment? lineEnd                                            -- include
    | "P" horizontal+ date horizontal+ commoditySymbol horizontal+ amount horizontal* inlineComment? lineEnd -- price
    | ";" horizontal* commentText lineEnd                                                                    -- comment
    | horizontal* newline                                                                                    -- blank

  description = (~forbiddenDescriptionSymbolCharacter any)+
  indentedComment = horizontal+ ";" horizontal* metadataComment lineEnd

  posting = horizontal+ account amountPart? horizontal* postingComment? lineEnd
  account = (~forbiddenAccountSymbolCharacter any)+
  amountPart = fieldSeparator amountExpression?

  amountExpression = balanceAssignment | explicitAmount
  balanceAssignment = "=" horizontal* amount
  explicitAmount = amount cost? balanceAssertion?
  cost = horizontal* ("@@" | "@") horizontal* amount
  balanceAssertion = horizontal* "=" horizontal* amount
  amount = number horizontal+ commoditySymbol

  number = sign? digit+ ("." digit+)?
  sign = "+" | "-"

  commodityBody = horizontal+ "format" horizontal+ formatQuantity horizontal+ commoditySymbol inlineComment? horizontal* lineEnd -- format
                | horizontal+ "default" inlineComment? lineEnd                                                                   -- default
  formatQuantity = digit "," digit digit digit ("." digit+)?    -- grouped
                 | digit digit digit digit ("." digit+)?        -- ungrouped

  commoditySymbol = (~forbiddenCommoditySymbolCharacter any)+

  postingComment = ";" horizontal* ("[" date "]" horizontal*)? metadataComment
  transactionComment = horizontal* ";" horizontal* metadataComment
  inlineComment = horizontal* ";" horizontal* commentText
  metadataComment = binaryTags (horizontal+ commentText)?  -- tags
                  | tagName ":" horizontal+ commentText    -- value
                  | commentText                            -- text
  binaryTags = ":" tagName (":" tagName)* ":"
  tagName = (~forbiddenTagNameCharacter any)+
  commentText = (~newline any)*
  directiveValue = (~forbiddenDirectiveValueCharacter any)+

  date = digit digit digit digit "-" digit digit "-" digit digit

  forbiddenDirectiveValueCharacter = ";" | newline
  forbiddenDescriptionSymbolCharacter = ";" | newline
  forbiddenAccountSymbolCharacter = fieldSeparator | ";" | newline
  forbiddenCommoditySymbolCharacter = horizontal | "@" | "=" | ";" | "\"" | "'" | newline
  forbiddenTagNameCharacter = horizontal | ":" | ";" | newline

  fieldSeparator = "\t"                -- tab
                 | "  " horizontal*    -- spaces

  lineEnd = newline | end
  horizontal = " " | "\t"
  newline = "\r\n" | "\n"
}
